CAPI=2:

name: fusesoc:pcie:tb_endpoint_line_rate:1.0.0
description: PCIe Gen1 x1/x4 logical-PHY line-rate verification for the endpoint

filesets:
  tb:
    files:
      - pcie_gen1_logical_phy_model.sv
      - tb_pcie_endpoint_line_rate.sv
      - pcie_gen1_traffic.py: {file_type: user, copyto: pcie_gen1_traffic.py}
      - test_pcie_endpoint_line_rate.py: {file_type: user, copyto: test_pcie_endpoint_line_rate.py}
    file_type: systemVerilogSource
    depend:
      - fusesoc:pcie:endpoint_protocol:1.0.0
      - fusesoc:pcie:phy_scrambler:1.0.0

parameters:
  LANE_COUNT:
    datatype: int
    default: 1
    description: Number of ideal synchronized Gen1 logical lanes (1 or 4)
    paramtype: vlogparam

targets:
  sim_x1:
    flow: sim
    flow_options:
      tool: verilator
      verilator_options:
        - --trace
        - --Wno-fatal
      cocotb_module: test_pcie_endpoint_line_rate
      timescale: 1ns/1ps
    filesets: [tb]
    parameters: [LANE_COUNT=1]
    toplevel: tb_pcie_endpoint_line_rate

  sim_x4:
    flow: sim
    flow_options:
      tool: verilator
      verilator_options:
        - --trace
        - --Wno-fatal
      cocotb_module: test_pcie_endpoint_line_rate
      timescale: 1ns/1ps
    filesets: [tb]
    parameters: [LANE_COUNT=4]
    toplevel: tb_pcie_endpoint_line_rate
