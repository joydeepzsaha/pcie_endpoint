CAPI=2:
name: fusesoc:pcie:tb_ltssm:1.0.0
description: pcie link training state machine

filesets:
  rtl:
    depend:
      - fusesoc:pcie:ltssm

  cocotb:
    files:
      - pcie_ltssm/tb/test_ltssm_configuration.py : {file_type : user, copyto : .}

  cocotb_linkup:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_linkup.py : {file_type : user, copyto : .}

  cocotb_recovery:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_recovery.py : {file_type : user, copyto : .}

  cocotb_detect_retry:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_detect_retry.py : {file_type : user, copyto : .}

  cocotb_polling_timeout:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_timeout.py : {file_type : user, copyto : .}

  cocotb_polling_timeout_tx_ok:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_timeout_tx_ok.py : {file_type : user, copyto : .}

  cocotb_config_timeout:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_timeout.py : {file_type : user, copyto : .}

  cocotb_partial_lanes:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_partial_lanes.py : {file_type : user, copyto : .}

  cocotb_recovery_partial_lanes:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_partial_lanes.py : {file_type : user, copyto : .}
      - test_ltssm_recovery_partial_lanes.py : {file_type : user, copyto : .}

  cocotb_polling_p4:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_p4.py : {file_type : user, copyto : .}

  cocotb_cfgidle_c26a:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_cfgidle_c26a.py : {file_type : user, copyto : .}

  cocotb_detect_d7:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_detect_d7.py : {file_type : user, copyto : .}

  cocotb_polling_p3:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_p3.py : {file_type : user, copyto : .}

  cocotb_config_c8:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_c8.py : {file_type : user, copyto : .}

  cocotb_config_conforms:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_conforms.py : {file_type : user, copyto : .}

  cocotb_rc_linkup:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_rc_linkup.py : {file_type : user, copyto : .}

  rtl_b2b:
    files:
      - tb_ltssm_b2b.sv : {file_type : systemVerilogSource}
    depend:
      - fusesoc:pcie:ltssm

  cocotb_b2b:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_b2b.py : {file_type : user, copyto : .}

  cocotb_b2b_x4:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_b2b_x4.py : {file_type : user, copyto : .}

targets:
  default:
    flow: sim
    flow_options:
      tool : icarus
      iverilog_options:
        - -g2012 -DCOCOTB_SIM # Use SystemVerilog-2012
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
    filesets : [rtl,cocotb]
    toplevel : [dllp_receive]
  
  sim:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -j 4
        - waiver.vlt
      vlogan_options:
        - -Wno-NTSFM -timescale=1ns/1ps +acc +vpd
      vcs_options:
        - +vcs+dumpvars+test.vcd
    filesets : [rtl,cocotb]
    toplevel : [pcie_phy_top]

  verilate:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl,cocotb]
    toplevel : [pcie_ltssm_downstream]

  verilate_fast:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_linkup
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_linkup]
    toplevel : [pcie_ltssm_downstream]

  verilate_recovery:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_recovery
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_recovery]
    toplevel : [pcie_ltssm_downstream]

  # Back-to-back RC<->EP link-up: two LTSSM instances in tb_ltssm_b2b.sv,
  # IS_ROOT_PORT set per-instance inside the harness. x1.
  verilate_b2b:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_b2b
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - --public-flat-rw
        - waiver.vlt
    filesets : [rtl_b2b,cocotb_b2b]
    toplevel : [tb_ltssm_b2b]

  # Back-to-back at x4: RC assigns Lane Numbers 0-3, EP echoes. Asserts the
  # per-lane assignment content, not just L0. --public-flat-rw exposes the
  # genvar-scoped counters for the per-lane hang dump.
  verilate_b2b_x4:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_b2b_x4
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - --public-flat-rw
        - waiver.vlt
    filesets : [rtl_b2b,cocotb_b2b_x4]
    toplevel : [tb_ltssm_b2b]

  # Root-Complex-mode link-up: DUT is the RC (IS_ROOT_PORT=1), x1 link,
  # LINK_NUM=1. First target to exercise the IS_ROOT_PORT=1 DUT behavior.
  verilate_rc_linkup:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_rc_linkup
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_rc_linkup]
    toplevel : [pcie_ltssm_downstream]

  verilate_detect_retry:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_detect_retry
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_detect_retry]
    toplevel : [pcie_ltssm_downstream]

  verilate_polling_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_timeout
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_timeout]
    toplevel : [pcie_ltssm_downstream]

  verilate_polling_timeout_tx_ok:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_timeout_tx_ok
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_timeout_tx_ok]
    toplevel : [pcie_ltssm_downstream]

  verilate_config_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_timeout
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_timeout]
    toplevel : [pcie_ltssm_downstream]

  verilate_partial_lanes:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_partial_lanes
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_partial_lanes]
    toplevel : [pcie_ltssm_downstream]

  verilate_recovery_partial_lanes:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_recovery_partial_lanes
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_recovery_partial_lanes]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle P4: WHEN the "1024 TS1 transmitted" limb must be met.
  # Base 2.1 4.2.6.2.1 p.220 counts it from entry to Polling.Active; the
  # "after receiving one TS1" qualifier on p.221 belongs to the 24 ms branch
  # only. :651 applies it to both. expect_fail row.
  verilate_polling_p4:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_p4
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_p4]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle C26a: how many times Configuration.Idle's 2 ms timeout
  # may divert to Recovery. Base 2.1 4.2.6.3.6 p.237 permits exactly one;
  # :979 compares the whole rate_id_t struct instead of .rate, so the 8'hFF
  # saturation is dead and 255 are admitted. expect_fail row.
  # Long by construction: TwoMsTimeOut is not SIM_FAST_LINK scaled, so each
  # of the two timeouts costs a real 200 000 cycles.
  verilate_cfgidle_c26a:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_cfgidle_c26a
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_cfgidle_c26a]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle D7: Detect.Active's "no Receiver detected" exit. Base 2.1
  # 4.2.6.1.2 p.219 requires Detect.Quiet; :592 goes to ST_IDLE, whose only
  # exit is `if (en_i)`. expect_fail row.
  verilate_detect_d7:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_detect_d7
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_detect_d7]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle P3: Polling.Active never reads TS Symbol 5, so a TS1 with
  # Compliance Receive = 1b and Loopback = 0b -- which qualifies under none of
  # Base 2.1 4.2.6.2.1 p.220's three conditions, and is p.221's
  # Polling.Compliance trigger -- is counted anyway. expect_fail row.
  verilate_polling_p3:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_p3
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_p3]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle C8: Configuration.Linkwidth.Accept adds an
  # `ordered_set_sent_cnt_r >= 8` gate that Base 2.1 4.2.6.3.2.1 p.230 does not
  # state -- the spec's condition is two consecutive matching TS1 alone.
  # expect_fail row.
  verilate_config_c8:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_c8
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_c8]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b: the predicted-CONFORMS Configuration oracles -- C3, C11, C14, C25.
  # Ordinary PASS rows, not expect_fail. Each ships a negative control that
  # withholds the spec condition and asserts the DUT does NOT advance, so a
  # green result cannot be a tautology.
  verilate_config_conforms:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_conforms
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_conforms]
    toplevel : [pcie_ltssm_downstream]

  synth:
    default_tool : vivado
    filesets : [rtl]
    tools:
      vivado:
        part : xczu5ev-sfvc784-1-e
    toplevel : pcie_phy_top

scripts:
  iceprog:
    cmd : [MODULE=pcie_ltssm_downstream]