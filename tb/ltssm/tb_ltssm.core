CAPI=2:
name: fusesoc:pcie:tb_ltssm:1.0.0
description: pcie link training state machine

filesets:
  rtl:
    depend:
      - fusesoc:pcie:ltssm

  cocotb:
    files:
      - pcie_ltssm/tb/test_ltssm_configuration.py : {file_type : user, copyto : .}

  cocotb_linkup:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_linkup.py : {file_type : user, copyto : .}

  cocotb_recovery:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_recovery.py : {file_type : user, copyto : .}

  cocotb_detect_retry:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_detect_retry.py : {file_type : user, copyto : .}

  cocotb_polling_timeout:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_timeout.py : {file_type : user, copyto : .}

  cocotb_polling_timeout_tx_ok:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_timeout_tx_ok.py : {file_type : user, copyto : .}

  cocotb_config_timeout:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_timeout.py : {file_type : user, copyto : .}

targets:
  default:
    flow: sim
    flow_options:
      tool : icarus
      iverilog_options:
        - -g2012 -DCOCOTB_SIM # Use SystemVerilog-2012
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
    filesets : [rtl,cocotb]
    toplevel : [dllp_receive]
  
  sim:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -j 4
        - waiver.vlt
      vlogan_options:
        - -Wno-NTSFM -timescale=1ns/1ps +acc +vpd
      vcs_options:
        - +vcs+dumpvars+test.vcd
    filesets : [rtl,cocotb]
    toplevel : [pcie_phy_top]

  verilate:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl,cocotb]
    toplevel : [pcie_ltssm_downstream]

  verilate_fast:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_linkup
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_linkup]
    toplevel : [pcie_ltssm_downstream]

  verilate_recovery:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_recovery
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_recovery]
    toplevel : [pcie_ltssm_downstream]

  verilate_detect_retry:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_detect_retry
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_detect_retry]
    toplevel : [pcie_ltssm_downstream]

  verilate_polling_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_timeout
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_timeout]
    toplevel : [pcie_ltssm_downstream]

  verilate_polling_timeout_tx_ok:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_timeout_tx_ok
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_timeout_tx_ok]
    toplevel : [pcie_ltssm_downstream]

  verilate_config_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_timeout
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_timeout]
    toplevel : [pcie_ltssm_downstream]

  synth:
    default_tool : vivado
    filesets : [rtl]
    tools:
      vivado:
        part : xczu5ev-sfvc784-1-e
    toplevel : pcie_phy_top

scripts:
  iceprog:
    cmd : [MODULE=pcie_ltssm_downstream]